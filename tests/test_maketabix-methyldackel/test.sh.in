#!@GNUBASH@

set -e
set -u

# Exercise the maketabix-methyldackel target in a clean, isolated work directory.
# The prerequisite fixtures are: 06_methyl_calls.
# The shared runner stages those artifacts, writes temporary settings, runs only
# this target, and verifies the expected representative output.
test_name="test_maketabix-methyldackel"
target="maketabix-methyldackel"
fixtures="06_methyl_calls"
expected="06_methyl_calls/methylDackel/tabix_CpG/PEsample_wgbs.deduped_CpG.txt.bgz"

exec "@abs_top_builddir@/tests/test-driver.sh" \
    "${test_name}" "${target}" "${fixtures}" "${expected}"
