#!@GNUBASH@

set -e
set -u

# Exercise the mapping-bwameth target in a clean, isolated work directory.
# The prerequisite fixtures are: 02_trimming genome.
# The shared runner stages those artifacts, writes temporary settings, runs only
# this target, and verifies the expected representative output.
test_name="test_mapping-bwameth"
target="mapping-bwameth"
fixtures="02_trimming genome"
expected="04_mapping/PEsample_wgbs.bwameth.bam"

exec "@abs_top_builddir@/tests/test-driver.sh" \
    "${test_name}" "${target}" "${fixtures}" "${expected}"
