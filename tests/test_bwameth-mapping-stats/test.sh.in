#!@GNUBASH@

set -e
set -u

# Exercise the bwameth-mapping-stats target in a clean, isolated work directory.
# The prerequisite fixtures are: 05_sorting_deduplication.
# The shared runner stages those artifacts, writes temporary settings, runs only
# this target, and verifies the expected representative output.
test_name="test_bwameth-mapping-stats"
target="bwameth-mapping-stats"
fixtures="05_sorting_deduplication"
expected="05_sorting_deduplication/PEsample_wgbs.bwameth.sorted.markdup.flagstat.txt"

exec "@abs_top_builddir@/tests/test-driver.sh" \
    "${test_name}" "${target}" "${fixtures}" "${expected}"
