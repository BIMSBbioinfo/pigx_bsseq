#!@GNUBASH@

set -e
set -u

# Exercise the mapping target in a clean, isolated work directory.
# The prerequisite fixtures are: 02_trimming 03_posttrimming_QC genome.
# The shared runner stages those artifacts, writes temporary settings, runs only
# this target, and verifies the expected representative output.
test_name="test_mapping"
target="mapping"
fixtures="02_trimming 03_posttrimming_QC genome"
expected="04_mapping/PEsample_wgbs_1_val_1_bismark_bt2_pe.bam"

exec "@abs_top_builddir@/tests/test-driver.sh" \
    "${test_name}" "${target}" "${fixtures}" "${expected}"
