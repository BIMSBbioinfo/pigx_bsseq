#!@GNUBASH@

set -e
set -u

# Exercise the markduplicates target in a clean, isolated work directory.
# The prerequisite fixtures are: 04_mapping.
# The shared runner stages those artifacts, writes temporary settings, runs only
# this target, and verifies the expected representative output.
test_name="test_markduplicates"
target="markduplicates"
fixtures="04_mapping"
expected="05_sorting_deduplication/PEsample_wgbs.bwameth.sorted.markdup.bam"

exec "@abs_top_builddir@/tests/test-driver.sh" \
    "${test_name}" "${target}" "${fixtures}" "${expected}"
