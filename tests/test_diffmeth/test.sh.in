#!@GNUBASH@

set -e
set -u

# Exercise the diffmeth target in a clean, isolated work directory.
# The prerequisite fixtures are: 09_differential_methylation.
# The shared runner stages those artifacts, writes temporary settings, runs only
# this target, and verifies the expected representative output.
test_name="test_diffmeth"
target="diffmeth"
fixtures="09_differential_methylation"
expected="09_differential_methylation/med1vsh2o/methylDiff_med1vsh2o_cpg_destranded_methylKit_results.tsv"

exec "@abs_top_builddir@/tests/test-driver.sh" \
    "${test_name}" "${target}" "${fixtures}" "${expected}"
