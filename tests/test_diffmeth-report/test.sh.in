#!@GNUBASH@

set -e
set -u

# Exercise the diffmeth-report target in a clean, isolated work directory.
# The prerequisite fixtures are: 04_mapping 09_differential_methylation.
# The shared runner stages those artifacts, writes temporary settings, runs only
# this target, and verifies the expected representative output.
test_name="test_diffmeth-report"
target="diffmeth-report"
fixtures="04_mapping 09_differential_methylation"
expected="Reports/med1vsh2o/med1vsh2o_cpg_destranded_methylKit.diffmeth-report.html"

exec "@abs_top_builddir@/tests/test-driver.sh" \
    "${test_name}" "${target}" "${fixtures}" "${expected}"
