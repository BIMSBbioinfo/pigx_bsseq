#!@GNUBASH@

set -e
set -u

# Exercise the genome-prep target in a clean, isolated work directory.
# This target has no prerequisite pipeline fixtures.
# The shared runner stages those artifacts, writes temporary settings, runs only
# this target, and verifies the expected representative output.
test_name="test_genome-prep"
target="genome-prep"
fixtures=""
expected="genome/Bisulfite_Genome/CT_conversion/genome_mfa.CT_conversion.fa"

exec "@abs_top_builddir@/tests/test-driver.sh" \
    "${test_name}" "${target}" "${fixtures}" "${expected}"
