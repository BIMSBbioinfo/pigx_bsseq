#!@GNUBASH@

set -e
set -u

# Exercise the final-report target in a clean, isolated work directory.
# The prerequisite fixtures are: 06_methyl_calls 07_bigwig_files 08_segmentation.
# The shared runner stages those artifacts, writes temporary settings, runs only
# this target, and verifies the expected representative output.
test_name="test_final-report"
target="final-report"
fixtures="06_methyl_calls 07_bigwig_files 08_segmentation"
expected="Reports/sample_reports/PEsample_wgbs_1_val_1_bt2.sorted.deduped_cpg_methylKit_hg19_final.html"

exec "@abs_top_builddir@/tests/test-driver.sh" \
    "${test_name}" "${target}" "${fixtures}" "${expected}"
