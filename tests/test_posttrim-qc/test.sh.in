#!@GNUBASH@
set -euo pipefail
test_name="test_posttrim-qc"
target="posttrim-qc"
fixtures="02_trimming"
expected="03_posttrimming_QC/PEsample_wgbs_1_val_1_fastqc.zip"
case "${target}" in unite|diffmeth|diffmeth-report|unite-bwameth|diffmeth-bwameth|diffmeth-report-bwameth) sample_mode=full ;; *) sample_mode=single ;; esac
root=$(mktemp --tmpdir -d "pigx.${test_name}.XXXXXX")
testdir="${root}/${test_name}"
trap 'rm -rf "${root}"' EXIT
mkdir -p "${testdir}/genome"
cp -R "${srcdir}/tests/in" "${testdir}/"
cp "${srcdir}/tests/sample_sheet.csv" "${testdir}/"
cp "${srcdir}/tests/genome/sample.fasta" "${srcdir}/tests/genome/cpgIslandExt.hg19.bed.gz" "${srcdir}/tests/genome/refGene.hg19.bed.gz" "${testdir}/genome/"
for fixture in ${fixtures}; do cp -R "${srcdir}/tests/sample_data/preprocessed/${fixture}" "${testdir}/"; done
if test -f "${testdir}/genome/sample.fasta.bwameth.c2t"; then touch "${testdir}/genome/sample.fasta.bwameth.c2t"*; fi
chmod -R u+w "${testdir}"
if test "${sample_mode}" = single; then sed -n '1p;2p' "${testdir}/sample_sheet.csv" > "${testdir}/sample_sheet.csv.tmp"; mv "${testdir}/sample_sheet.csv.tmp" "${testdir}/sample_sheet.csv"; fi
settings="${testdir}/settings.yaml"
sed -e "s|input-dir: .*|input-dir: ${testdir}/in/|" -e "s|output-dir: .*|output-dir: ${testdir}/|" -e "s|genome-fasta: .*|genome-fasta: ${testdir}/genome/sample.fasta|" -e "s|cpgIsland-bedfile: .*|cpgIsland-bedfile: ${testdir}/genome/cpgIslandExt.hg19.bed.gz|" -e "s|refGenes-bedfile: .*|refGenes-bedfile: ${testdir}/genome/refGene.hg19.bed.gz|" "${srcdir}/tests/settings.yaml" > "${settings}"
if test "${sample_mode}" = single; then sed -i '/^DManalyses:/,/^execution:/ { /^execution:/!d }' "${settings}"; fi
export SOURCE_DATE_EPOCH=1 PIGX_UGLY=1 PIGX_UNINSTALLED=1 XDG_CACHE_HOME="${testdir}/cache"
"${builddir}/pigx-bsseq" -c "${testdir}/config.json" -s "${settings}" "${testdir}/sample_sheet.csv" --target "${target}" --snakemake=--notemp
test -f "${testdir}/${expected}"
