#!@GNUBASH@

set -e
set -u

# Exercise the posttrim-qc target in a clean, isolated work directory.
# The prerequisite fixtures are: 02_trimming.
# The shared runner stages those artifacts, writes temporary settings, runs only
# this target, and verifies the expected representative output.
test_name="test_posttrim-qc"
target="posttrim-qc"
fixtures="02_trimming"
expected="03_posttrimming_QC/PEsample_wgbs_1_val_1_fastqc.zip"

exec "@abs_top_builddir@/tests/test-driver.sh" \
    "${test_name}" "${target}" "${fixtures}" "${expected}"
