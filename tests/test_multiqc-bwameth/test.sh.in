#!@GNUBASH@

set -e
set -u

# Exercise the multiqc-bwameth target in a clean, isolated work directory.
# The prerequisite fixtures are: 01_raw_QC 02_trimming 03_posttrimming_QC 05_sorting_deduplication.
# The shared runner stages those artifacts, writes temporary settings, runs only
# this target, and verifies the expected representative output.
test_name="test_multiqc-bwameth"
target="multiqc-bwameth"
fixtures="01_raw_QC 02_trimming 03_posttrimming_QC 05_sorting_deduplication"
expected="Reports/multiqc/bwameth_multiqc_report.html"

exec "@abs_top_builddir@/tests/test-driver.sh" \
    "${test_name}" "${target}" "${fixtures}" "${expected}"
